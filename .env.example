# RenewOps Environment Configuration
# Copy to .env and adjust values for your environment

# --- Database ---
# For local SQLite (quick start): sqlite:///./renewops.db
# For local PostgreSQL / Docker: postgresql+psycopg2://renewops:renewops@localhost:5432/renewops
# For managed PostgreSQL (Neon / Supabase / Render): postgresql+psycopg2://<user>:<password>@<host>:5432/<dbname>?sslmode=require
DATABASE_URL=postgresql+psycopg2://renewops:renewops@localhost:5432/renewops

# --- App Settings ---
DEBUG=false
APP_NAME=RenewOps
APP_VERSION=1.0.0

# --- CORS (comma-separated origins or * for all) ---
ALLOWED_ORIGINS=*

# --- MCP Security ---
# Set a secret token for Claude remote connector auth (leave empty for open demo access)
# If set, Claude/clients must send header: Authorization: Bearer <MCP_API_KEY>
MCP_API_KEY=

# --- MCP Server Standalone Port ---
MCP_SERVER_PORT=8001

# --- Demo Org & Tenancy ---
DEMO_ORG_ID=00000000-0000-0000-0000-000000000001
DEMO_ORG_NAME=Demo Organization
DEFAULT_CURRENCY=INR
